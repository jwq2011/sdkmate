# 服务器列表配置文件
# 格式: 别名|主机|端口|用户|标签
# 标签用于 prompt 个性化显示

# ==================== 生产环境 ====================
[production]
# 示例: prod|192.168.1.10|22|root|生产集群
prod|192.168.1.10|22|root|生产集群

# ==================== 测试环境 ====================
[testing]
# 示例: test|192.168.1.11|22|root|测试环境
test|192.168.1.11|22|root|测试环境

# ==================== 开发环境 ====================
[development]
# 示例: dev|192.168.1.12|22|user|开发机
dev|192.168.1.12|22|user|开发机

# ==================== 使用说明 ====================
# 1. 每行格式: 别名|主机|端口|用户|标签
# 2. 别名用于快速选择和显示
# 3. 端口默认为 22，可省略
# 4. 标签用于部署到服务器后的 prompt 个性化
#
# 示例配置:
#   web1|192.168.1.100|22|admin|Web服务器
#   db1|192.168.1.101|22|admin|数据库
#   cache1|192.168.1.102||user|缓存服务
#                         ↑ 端口可省略